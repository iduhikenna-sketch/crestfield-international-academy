<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Academics | Crestfield International Academy</title>

  <meta name="description" content="Explore the academic programmes, curriculum, teaching approach, assessment and learning opportunities at Crestfield International Academy.">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      color: #172033;
      background: #f7f9fc;
      line-height: 1.7;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    /* DEMO BAR */
    .demo-bar {
      background: #101c36;
      color: #ffffff;
      text-align: center;
      padding: 10px 15px;
      font-size: 13px;
      letter-spacing: 0.4px;
    }

    /* HEADER */
    header {
      background: #ffffff;
      position: sticky;
      top: 0;
      z-index: 1000;
      box-shadow: 0 3px 15px rgba(0,0,0,0.08);
    }

    .nav-container {
      width: 92%;
      max-width: 1200px;
      margin: auto;
      min-height: 78px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 25px;
    }

    .logo {
      font-size: 20px;
      font-weight: 800;
      color: #102347;
      line-height: 1.2;
    }

    .logo span {
      display: block;
      color: #c79a38;
      font-size: 11px;
      letter-spacing: 2px;
      margin-top: 3px;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 18px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    nav a {
      color: #26334d;
      font-size: 14px;
      font-weight: 600;
      transition: 0.3s;
    }

    nav a:hover,
    nav a.active {
      color: #b38324;
    }

    .apply-btn {
      background: #c79a38;
      color: #ffffff !important;
      padding: 11px 18px;
      border-radius: 6px;
      font-weight: 700;
    }

    .apply-btn:hover {
      background: #a97d1d;
    }

    /* HERO */
    .page-hero {
      min-height: 450px;
      background:
        linear-gradient(rgba(12,28,58,0.83), rgba(12,28,58,0.89)),
        url("https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=1600&q=85")
        center/cover no-repeat;

      display: flex;
      align-items: center;
      text-align: center;
      color: #ffffff;
    }

    .hero-content {
      width: 92%;
      max-width: 900px;
      margin: auto;
      padding: 60px 0;
    }

    .eyebrow {
      color: #c79a38;
      text-transform: uppercase;
      letter-spacing: 2.5px;
      font-size: 12px;
      font-weight: 800;
      margin-bottom: 12px;
    }

    .hero-content .eyebrow {
      color: #e0b85d;
    }

    .hero-content h1 {
      font-size: clamp(38px, 6vw, 68px);
      line-height: 1.08;
      margin-bottom: 20px;
    }

    .hero-content p {
      max-width: 750px;
      margin: auto;
      font-size: 18px;
      color: #edf2fb;
    }

    /* GENERAL */
    .section {
      width: 92%;
      max-width: 1180px;
      margin: auto;
      padding: 85px 0;
    }

    .section-heading {
      max-width: 780px;
      margin-bottom: 45px;
    }

    .section-heading.center {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    h2 {
      color: #102347;
      font-size: clamp(30px, 4vw, 45px);
      line-height: 1.2;
      margin-bottom: 18px;
    }

    .section-heading p {
      color: #5d687d;
      font-size: 16px;
    }

    /* OVERVIEW */
    .overview {
      background: #ffffff;
    }

    .overview-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 55px;
      align-items: center;
    }

    .overview-text p {
      color: #5d687d;
      margin-bottom: 18px;
    }

    .overview-image {
      min-height: 420px;
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 18px 45px rgba(16,35,71,0.14);
    }

    .overview-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* ACADEMIC LEVELS */
    .levels {
      background: #f1f4f8;
    }

    .levels-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 25px;
    }

    .level-card {
      background: #ffffff;
      padding: 35px;
      border-radius: 14px;
      border: 1px solid #e1e6ef;
      position: relative;
      overflow: hidden;
      transition: 0.3s;
    }

    .level-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 35px rgba(16,35,71,0.09);
    }

    .level-number {
      color: #c79a38;
      font-size: 14px;
      font-weight: 800;
      letter-spacing: 1px;
      margin-bottom: 10px;
    }

    .level-card h3 {
      color: #102347;
      font-size: 25px;
      margin-bottom: 12px;
    }

    .level-card p {
      color: #667187;
      font-size: 15px;
    }

    .level-card ul {
      margin-top: 18px;
      padding-left: 20px;
      color: #5f6b80;
    }

    .level-card li {
      margin-bottom: 7px;
    }

    /* CURRICULUM */
    .curriculum {
      background: #102347;
      color: #ffffff;
    }

    .curriculum h2 {
      color: #ffffff;
    }

    .curriculum .section-heading p {
      color: #d7dfed;
    }

    .curriculum-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .curriculum-card {
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.13);
      padding: 32px;
      border-radius: 14px;
    }

    .curriculum-card h3 {
      color: #ffffff;
      margin-bottom: 12px;
      font-size: 21px;
    }

    .curriculum-card p {
      color: #d1d9e8;
      font-size: 14px;
    }

    /* TEACHING APPROACH */
    .teaching {
      background: #ffffff;
    }

    .teaching-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .teaching-card {
      padding: 35px 28px;
      background: #f8f9fc;
      border-radius: 14px;
      border-top: 4px solid #c79a38;
    }

    .teaching-card h3 {
      color: #102347;
      margin-bottom: 12px;
      font-size: 21px;
    }

    .teaching-card p {
      color: #657086;
      font-size: 15px;
    }

    /* ASSESSMENT */
    .assessment-grid {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 55px;
      align-items: center;
    }

    .assessment-text p {
      color: #5d687d;
      margin-bottom: 18px;
    }

    .assessment-list {
      display: grid;
      gap: 15px;
    }

    .assessment-item {
      background: #ffffff;
      padding: 20px 22px;
      border-left: 4px solid #c79a38;
      box-shadow: 0 8px 25px rgba(16,35,71,0.07);
      border-radius: 7px;
    }

    .assessment-item h3 {
      color: #102347;
      font-size: 18px;
      margin-bottom: 5px;
    }

    .assessment-item p {
      color: #687489;
      font-size: 14px;
    }

    /* SUPPORT */
    .support {
      background: #f1f4f8;
    }

    .support-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .support-card {
      background: #ffffff;
      padding: 32px;
      border-radius: 14px;
      border: 1px solid #e0e5ed;
    }

    .support-card h3 {
      color: #102347;
      margin-bottom: 10px;
      font-size: 21px;
    }

    .support-card p {
      color: #657086;
      font-size: 14px;
    }

    /* DIGITAL LEARNING */
    .digital-grid {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      gap: 55px;
      align-items: center;
    }

    .digital-image {
      min-height: 390px;
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 18px 45px rgba(16,35,71,0.14);
    }

    .digital-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .digital-text p {
      color: #5d687d;
      margin-bottom: 18px;
    }

    .digital-points {
      display: grid;
      gap: 12px;
      margin-top: 22px;
    }

    .digital-point {
      padding: 16px 18px;
      background: #f5f7fa;
      border-radius: 8px;
      border-left: 3px solid #c79a38;
    }

    .digital-point strong {
      color: #102347;
    }

    /* ENRICHMENT */
    .enrichment {
      background: #ffffff;
    }

    .enrichment-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .enrichment-card {
      padding: 32px;
      border: 1px solid #e0e5ed;
      border-radius: 14px;
      background: #fbfcfe;
    }

    .enrichment-card h3 {
      color: #102347;
      margin-bottom: 10px;
      font-size: 21px;
    }

    .enrichment-card p {
      color: #687489;
      font-size: 14px;
    }

    /* OUTCOMES */
    .outcomes {
      background: #102347;
      color: #ffffff;
    }

    .outcomes h2 {
      color: #ffffff;
    }

    .outcomes .section-heading p {
      color: #d7dfed;
    }

    .outcomes-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    .outcome {
      padding: 28px 22px;
      border: 1px solid rgba(255,255,255,0.14);
      border-radius: 12px;
      background: rgba(255,255,255,0.06);
    }

    .outcome h3 {
      color: #ffffff;
      font-size: 18px;
      margin-bottom: 8px;
    }

    .outcome p {
      color: #ccd5e4;
      font-size: 13px;
    }

    /* CTA */
    .cta {
      background: #f4f6fa;
      text-align: center;
    }

    .cta-box {
      background: #ffffff;
      max-width: 900px;
      margin: auto;
      padding: 55px 35px;
      border-radius: 18px;
      box-shadow: 0 15px 40px rgba(16,35,71,0.09);
    }

    .cta-box p {
      color: #657086;
      max-width: 650px;
      margin: 0 auto 25px;
    }

    .cta-buttons {
      display: flex;
      justify-content: center;
      gap: 14px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;
      padding: 13px 22px;
      border-radius: 7px;
      font-weight: 700;
      font-size: 14px;
    }

    .btn-primary {
      background: #c79a38;
      color: #ffffff;
    }

    .btn-primary:hover {
      background: #a97d1d;
    }

    .btn-secondary {
      border: 1px solid #102347;
      color: #102347;
    }

    .btn-secondary:hover {
      background: #102347;
      color: #ffffff;
    }

    /* FOOTER */
    footer {
      background: #0b172f;
      color: #cbd3e1;
      padding: 55px 0 25px;
    }

    .footer-container {
      width: 92%;
      max-width: 1180px;
      margin: auto;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 45px;
      padding-bottom: 35px;
      border-bottom: 1px solid rgba(255,255,255,0.12);
    }

    footer h3 {
      color: #ffffff;
      margin-bottom: 15px;
      font-size: 18px;
    }

    footer p {
      font-size: 14px;
      color: #aeb9cb;
    }

    .footer-links a {
      display: block;
      color: #aeb9cb;
      font-size: 14px;
      margin-bottom: 8px;
    }

    .footer-links a:hover {
      color: #e0b85d;
    }

    .footer-bottom {
      text-align: center;
      padding-top: 22px;
      font-size: 13px;
      color: #8f9bae;
    }

    /* RESPONSIVE */
    @media (max-width: 950px) {

      .nav-container {
        flex-direction: column;
        padding: 18px 0;
      }

      nav {
        justify-content: center;
      }

      .overview-grid,
      .assessment-grid,
      .digital-grid {
        grid-template-columns: 1fr;
      }

      .levels-grid {
        grid-template-columns: 1fr;
      }

      .curriculum-grid,
      .teaching-grid,
      .support-grid,
      .enrichment-grid {
        grid-template-columns: 1fr 1fr;
      }

      .outcomes-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 650px) {

      .demo-bar {
        font-size: 11px;
      }

      nav {
        gap: 10px 13px;
      }

      nav a {
        font-size: 12px;
      }

      .page-hero {
        min-height: 380px;
      }

      .hero-content p {
        font-size: 16px;
      }

      .section {
        padding: 65px 0;
      }

      .overview-image,
      .digital-image {
        min-height: 320px;
      }

      .curriculum-grid,
      .teaching-grid,
      .support-grid,
      .enrichment-grid,
      .outcomes-grid {
        grid-template-columns: 1fr;
      }

      .level-card,
      .curriculum-card,
      .teaching-card,
      .support-card,
      .enrichment-card {
        padding: 28px;
      }

      .footer-grid {
        grid-template-columns: 1fr;
        gap: 30px;
      }
    }
  </style>
</head>

